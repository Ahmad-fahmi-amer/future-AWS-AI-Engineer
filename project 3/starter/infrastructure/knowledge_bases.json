                [
                  "arn:",
                  {
                    "Ref": "AWS::Partition"
                  },
                  ":s3:::",
                  {
                    "Fn::ImportValue": {
                      "Fn::Sub": "${ProjectName}-PolicyBucket"
                    }
                  }
                ]
              ]
            },
            "InclusionPrefixes": [
              "policies/warranty/"
            ]
          }
        },
        "VectorIngestionConfiguration": {
          "ChunkingConfiguration": {
            "ChunkingStrategy": "FIXED_SIZE",
            "FixedSizeChunkingConfiguration": {
              "MaxTokens": 300,
              "OverlapPercentage": 20
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "ReturnsKbId": {
      "Value": {
        "Ref": "ReturnsKnowledgeBase"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${ProjectName}-ReturnsKbId"
        }
      }
    },
    "ReturnsDataSourceId": {
      "Value": {
        "Fn::GetAtt": [
          "ReturnsDataSource",
          "DataSourceId"
        ]
      }
    },
    "ShippingKbId": {
      "Value": {
        "Ref": "ShippingKnowledgeBase"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${ProjectName}-ShippingKbId"
        }
      }
    },
    "ShippingDataSourceId": {
      "Value": {
        "Fn::GetAtt": [
          "ShippingDataSource",
          "DataSourceId"
        ]
      }
    },
    "WarrantyKbId": {
      "Value": {
        "Ref": "WarrantyKnowledgeBase"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${ProjectName}-WarrantyKbId"
        }
      }
    },
    "WarrantyDataSourceId": {
      "Value": {
        "Fn::GetAtt": [
          "WarrantyDataSource",
          "DataSourceId"
        ]
      }
    }
  }
}
